cff-version: 1.2.0message: "If you use this software, please cite the associated article and this software repository."title: "Competing Information Diffusion in Crisis Communication Networks"type: softwareauthors:  - family-names: "Hatzivelkos"    given-names: "Aleksandar"year: 2026license: MITabstract: >  Wolfram Mathematica implementation of a discrete-time network model for  competing misinformation and official information in crisis communication.  The software includes network generation, initialization, stochastic  diffusion simulation, outcome metrics, data export utilities, and a compact  demonstration notebook.keywords:  - misinformation  - information diffusion  - crisis communication  - network simulation  - stochastic simulation  - Wolfram Mathematica  - computational modelingrepository-code: "[GITHUB REPOSITORY URL TO BE ADDED]"references:  - type: article    title: "A Mathematical Simulation Model of Competing Information Diffusion in Crisis Communication Networks"    authors:      - family-names: "Hatzivelkos"        given-names: "Aleksandar"    year: 2026    doi: "[ARTICLE DOI TO BE ADDED]"  - type: dataset    title: "Simulation Data for A Mathematical Simulation Model of Competing Information Diffusion in Crisis Communication Networks"    authors:      - family-names: "Hatzivelkos"        given-names: "Aleksandar"    year: 2026    doi: "[ZENODO DATASET DOI TO BE ADDED]"